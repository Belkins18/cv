{
  "extends": "@cv/config/tsconfig/react.json",
  // scripts/pdf.ts and the vite/vitest configs are Node code: they need console,
  // fs/promises and import.meta.url. The @cv/config/tsconfig/react.json preset
  // only knows vite/client, so "node" is added here rather than in the shared preset.
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "cv-phone.ts",
    "scripts",
    "test",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.pdf.config.ts"
  ]
}
