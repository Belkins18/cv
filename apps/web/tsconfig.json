{
  "extends": "@cv/config/tsconfig/react.json",
  // Конфиги vite/vitest читают пути от import.meta.url — это node-код. Пресет
  // @cv/config/tsconfig/react.json знает только vite/client, поэтому "node"
  // дописывается здесь, а не в общем пресете.
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "e2e",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
