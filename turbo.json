{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "locales/**"],
      "env": ["CV_PHONE"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "pdf": {
      "dependsOn": ["build"],
      "outputs": ["../../out/*.pdf"],
      "env": ["CV_PHONE"]
    },
    "verify:pdf": {
      "dependsOn": ["pdf"],
      "env": ["CV_PHONE"]
    }
  },
  "globalDependencies": [".env"]
}
